{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kontur": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kontur",
      "options": {
        "baseURL": "https://srs-litellm.kontur.host/v1",
        "apiKey": "{env:KONTUR_CODE_PRO_API_KEY}"
      },
      "models": {
        "code-pro": {
          "name": "code-pro",
          "limit": {
            "context": 60416,
            "output": 4096
          }
        },
        "preview-code-pro": {
          "name": "preview-code-pro",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        }
      }
    }
  }
}
