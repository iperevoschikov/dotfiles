{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kontur": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kontur",
      "options": {
        "baseURL": "https://srs-litellm.kontur.host/v1",
        "apiKey": "{env:KONTUR_CODE_PRO_API_KEY}"
      },
      "models": {
        "code-pro": {
          "name": "code-pro",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        "ultra": {
          "name": "code-ultra",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "rag-aas-prd": {
      "type": "remote",
      "url": "https://rag-service-rag-aas-prd.kontur.host/mcp/",
      "enabled": true,
      "oauth": {
        "clientId": "RAG-As-A-Service.API"
      },
      "timeout": 600000
    },
    "talk": {
      "type": "remote",
      "url": "http://127.0.0.1:44260/mcp",
      "headers": { "Authorization": "Bearer {env:KONTUR_TALK_TOKEN}" }
    }
  }
}
